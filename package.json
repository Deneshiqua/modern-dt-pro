{
  "name": "modern-dt-pro",
  "version": "0.2.2",
  "description": "Modern DataTable Pro",
  "author": "Deniz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deneshiqua/modern-dt-pro.git"
  },
  "homepage": "https://github.com/deneshiqua/modern-dt-pro#readme",
  "bugs": {
    "url": "https://github.com/deneshiqua/modern-dt-pro/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@heroicons/react": "^2.2.0",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "clsx": "^2.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "react",
    "datatable",
    "tanstack-table",
    "grouping",
    "excel-export"
  ]
}
